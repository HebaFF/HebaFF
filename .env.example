# Local dev default (SQLite, zero setup). For production, use a real Postgres
# URL and switch prisma/schema.prisma's datasource provider to "postgresql".
DATABASE_URL="file:./dev.db"

# Long random secret used to sign session JWTs. Generate with:
#   openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret"

# Stripe (one-time payment / Checkout, NOT subscription mode)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price must be a one-time (not recurring) Stripe Price object, $29.99
STRIPE_PREMIUM_PRICE_ID="price_..."

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Password reset emails (Resend). Without this set, reset emails are logged
# to the server console instead of sent, and /api/auth/forgot-password
# returns the reset link directly in dev so the flow is still testable.
RESEND_API_KEY=""
EMAIL_FROM="GlucoDose <onboarding@resend.dev>"
