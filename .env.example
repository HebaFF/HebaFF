# Local dev default (SQLite, zero setup). For production, use a real Postgres
# URL and switch prisma/schema.prisma's datasource provider to "postgresql".
DATABASE_URL="file:./dev.db"

# Long random secret used to sign session JWTs. Generate with:
#   openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret"

# Paymob (one-time card payment via the Accept "standard redirect" iframe
# flow — NOT a recurring subscription). All four required to process a real
# payment; find them in your Paymob dashboard.
PAYMOB_API_KEY=""
# The integration id for your card-payment method (Settings > Payment Integrations)
PAYMOB_INTEGRATION_ID=""
# The iframe id (Settings > Payment Integrations > iFrames tab)
PAYMOB_IFRAME_ID=""
# Settings > Account Info > HMAC secret — used to verify the webhook
PAYMOB_HMAC_SECRET=""
# Amount in the smallest currency unit (piastres for EGP) — must match what
# your PAYMOB_INTEGRATION_ID is configured to accept. $5 ≈ 250 EGP as of
# writing; check the current rate and your account's actual pricing.
PAYMOB_AMOUNT_CENTS="25000"
PAYMOB_CURRENCY="EGP"

# Google Play Billing (Android app only — website and iOS keep using
# Paymob above). The full JSON key of a Google Cloud service account
# linked to Play Console with "Financial data" + "Manage orders and
# subscriptions" access for this app: Play Console > Setup > API access.
# Paste the whole downloaded .json file's contents as a single-line string.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=""

# Apple In-App Purchases (iOS app only — website and Android keep using
# their own processors above). Unlike Play Billing, this needs no
# per-app account credentials — just Apple's own public root certificate,
# used to cryptographically verify signed purchase transactions offline.
# Download "Apple Root CA - G3 Root" from https://www.apple.com/certificateauthority/
# (the .cer file), then base64-encode it into a single-line string, e.g.:
#   base64 -i AppleRootCA-G3.cer | tr -d '\n'
APPLE_ROOT_CA_G3_BASE64=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Password reset emails (Resend). Without this set, reset emails are logged
# to the server console instead of sent, and /api/auth/forgot-password
# returns the reset link directly in dev so the flow is still testable.
RESEND_API_KEY=""
EMAIL_FROM="GlucoDose <onboarding@resend.dev>"
